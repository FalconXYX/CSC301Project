generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model clinics {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  phone                 String?
  email                 String?
  website               String?
  address_line1         String
  address_line2         String?
  city                  String
  province              String                 @default("ON")
  postal_code           String
  latitude              Decimal?               @db.Decimal
  longitude             Decimal?               @db.Decimal
  booking_provider      String?
  booking_url           String?
  offers_direct_billing Boolean                @default(false)
  specialties_json      Json?
  services_json         Json?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  appointment_requests  appointment_requests[]
  clinic_insurances     clinic_insurances[]
  practitioners         practitioners[]
  users                 users[]

  @@map("clinics")
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                 @unique
  phone                String?
  password_hash        String
  role                 String
  first_name           String?
  last_name            String?
  date_of_birth        DateTime?              @db.Date
  clinic_id            String?                @db.Uuid
  clinic_role          String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  google_access_token  String?
  google_refresh_token String?
  google_token_expiry  DateTime?              @db.Timestamptz(6)
  google_calendar_id   String?
  appointment_requests appointment_requests[]
  practitioner         practitioners?
  clinic               clinics?               @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("users")
}

model practitioners {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                 @unique @db.Uuid
  profession           String
  bio                  String?
  clinic_id            String?                @db.Uuid
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  appointment_requests appointment_requests[]
  clinic               clinics?               @relation(fields: [clinic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("practitioners")
}

model insurances {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  clinic_insurances clinic_insurances[]

  @@map("insurances")
}

model clinic_insurances {
  clinic_id               String     @db.Uuid
  insurance_id            String     @db.Uuid
  supports_direct_billing Boolean    @default(false)
  notes                   String?
  clinic                  clinics    @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insurance               insurances @relation(fields: [insurance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([clinic_id, insurance_id])
  @@index([insurance_id, supports_direct_billing], map: "idx_clinic_insurances_insurance_direct")
  @@map("clinic_insurances")
}

model appointment_requests {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_user_id  String         @db.Uuid
  clinic_id        String         @db.Uuid
  practitioner_id  String?        @db.Uuid
  preferred_start  DateTime?      @db.Timestamptz(6)
  preferred_end    DateTime?      @db.Timestamptz(6)
  constraints_json Json?
  status           String
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  google_event_id  String?
  clinic           clinics        @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient          users          @relation(fields: [patient_user_id], references: [id], onUpdate: NoAction)
  practitioner     practitioners? @relation(fields: [practitioner_id], references: [id], onUpdate: NoAction)

  @@index([clinic_id, status, created_at], map: "idx_appointment_requests_clinic_status_created")
  @@index([patient_user_id, created_at], map: "idx_appointment_requests_patient_created")
  @@map("appointment_requests")
}
